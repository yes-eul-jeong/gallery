---
import { getCollection, getEntry } from 'astro:content'
import Base from '../layouts/Base.astro'
import Hero from '../components/Hero.astro'
import Record from '../components/Record.astro'
import BoutStatus from '../components/BoutStatus.astro'
import MatchRow from '../components/MatchRow.astro'
import VideoSlider from '../components/VideoSlider.astro'
import VideoCard from '../components/VideoCard.astro'
import Breakdown from '../components/Breakdown.astro'
import PhotoFan from '../components/PhotoFan.astro'
import Contact from '../components/Contact.astro'
import Lightbox from '../components/Lightbox.astro'
import { tally, byDateDesc } from '../lib/record'
import { url } from '../lib/media'
import { ui, levelLabel, methodLabel, resultLabel, trainingLabel, formatDate, formatDuration } from '../i18n/ko'

const profile = await getEntry('profile', 'main')
if (!profile) throw new Error('profile.json 에 main 항목이 없습니다')
const p = profile.data

const matches = (await getCollection('matches')).sort(byDateDesc)
const training = (await getCollection('training')).sort(byDateDesc)

const pro = tally(matches, 'pro')
const semipro = tally(matches, 'semipro')
const amateur = tally(matches, 'amateur')
const all = {
  win: pro.win + semipro.win + amateur.win,
  loss: pro.loss + semipro.loss + amateur.loss,
  draw: pro.draw + semipro.draw + amateur.draw,
  ko: pro.ko + semipro.ko + amateur.ko,
  noContest: pro.noContest + semipro.noContest + amateur.noContest,
}

// 첫 화면에는 최근 5경기만. 전부 늘어놓으면 최근 경기가 묻힌다.
const recent = matches.slice(0, 5)

// 영상 슬라이드: 경기 영상을 먼저, 훈련 영상을 뒤에
const clips = [
  ...matches
    .filter((m) => m.data.video)
    .map((m) => ({
      href: `/match/${m.id}`,
      kind: `${levelLabel[m.data.level]} · ${resultLabel[m.data.result]}`,
      title: `${m.data.event} · ${m.data.title}`,
      text: [formatDate(m.data.date), m.data.opponent.country, formatDuration(m.data.video!.duration)]
        .filter(Boolean)
        .join(' · '),
      poster: m.data.video!.poster,
      preview: m.data.video!.preview,
    })),
  ...training
    .filter((t) => t.data.video)
    .map((t) => ({
      href: `/training/${t.id}`,
      kind: trainingLabel[t.data.type],
      title: t.data.title,
      text: [formatDate(t.data.date), t.data.place, formatDuration(t.data.video!.duration)]
        .filter(Boolean)
        .join(' · '),
      poster: t.data.video!.poster,
      preview: t.data.video!.preview,
    })),
].slice(0, 6)

// 부채: 경기마다 대표 사진 한 장
type FanCard = { href: string; image: string; kind: string; title: string; sub: string }

const fanImages = ['g1.jpg', 'g2.jpg', 'g3.jpg', 'g5.jpg', 'g8.jpg']
const fanCards: FanCard[] = matches.slice(0, 4).map((m, i) => ({
  href: `/match/${m.id}`,
  image: fanImages[i] ?? 'g1.jpg',
  kind: levelLabel[m.data.level],
  title: m.data.event,
  sub: `${formatDate(m.data.date)} · ${methodLabel[m.data.method]} ${resultLabel[m.data.result]}`,
}))
fanCards.push({
  href: '/gallery',
  image: 'g8.jpg',
  kind: '훈련',
  title: p.gym,
  sub: '상시 · 전체 갤러리',
})
---

<Base title={`${p.name} · 파이트 레주메`} here="home">
  <main>
    <Hero profile={p} record={pro} />
    <Record pro={pro} semipro={semipro} amateur={amateur} />
    <BoutStatus profile={p} />

    <section class="section">
      <div class="section__inner">
        <div class="section__head">
          <div class="label" style="flex:1">{ui.eventResults}</div>
          <a class="link-more" href={url('/videos?type=match')}>{ui.viewAll} <span>→</span></a>
        </div>
        <div class="match-list">
          {recent.map((m) => <MatchRow match={m} />)}
        </div>
      </div>
    </section>

    {clips.length > 0 && (
      <section class="section">
        <div class="section__inner">
          <div class="section__head">
            <div class="label" style="flex:1">{ui.videos}</div>
            <a class="link-more" href={url('/videos')}>{ui.viewList} <span>→</span></a>
          </div>
          <VideoSlider id="main">
            {clips.map((c) => <VideoCard {...c} />)}
          </VideoSlider>
        </div>
      </section>
    )}

    <Breakdown pro={pro} all={all} />
    <PhotoFan cards={fanCards} />
    <Contact profile={p} />
  </main>

  <Lightbox />
</Base>
